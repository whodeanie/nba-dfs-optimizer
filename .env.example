# Groq API key for the per lineup AI reasoning layer.
# Optional. If unset, the app falls back to a deterministic rules based explainer.
# Get one free at https://console.groq.com.
GROQ_API_KEY=

# Optional. Override the default model.
# Defaults to llama-3.3-70b-versatile, served free on Groq.
GROQ_MODEL=

# OddsAPI free tier (https://the-odds-api.com). Used for live salary and slate
# context. Optional, the optimizer falls back to a static slate when missing.
ODDS_API_KEY=

# Public site URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://nba-dfs-optimizer.vercel.app
