# Anthropic API key for the per lineup AI reasoning layer.
# Optional. If unset, the app falls back to a deterministic rules based explainer.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. If you want a different default model, set it here.
# Defaults to claude-haiku-4-5-20251001 to keep cost near $0.01 per lineup.
ANTHROPIC_MODEL=

# Public site URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://nba-dfs-optimizer.vercel.app
